
import tkinter as tk
window = tk.Tk()

#for rows is outtermost
for i in range(3):
    #for columns is innermost
    for j in range(3):
        frame = tk.Frame(
            master=window,
            relief=tk.RAISED,
            borderwidth=1
        )
        frame.grid(row=i, column=j, padx=5, pady=5)
        label = tk.Label(master=frame, text=f"Row {i}\nColumn{j}")
        label.pack()
window.mainloop()
