
class Expression:
    def __init__(self, num1, num2, num3):
        self.num1 = num1
        self.num2 = num2
        self.num3 = num3
    def addition(self):
        result = self.num1 + self.num2 + self.num3
        print("This is the result", result)

obj1 = Expression(11, 12, 13)
obj1.addition()
