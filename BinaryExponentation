def fast_power(base, exp):
    result = 1
    while exp>0:
        if exp&1:
            result = result * base
        base = base*base
        exp  = exp>>1
    return result

print("Binary Exponentaion: ")
print("6 ^5 = ",fast_power(6,5))
print("2 ^10 = ",fast_power(2,10))
print("34 ^1000 = ",fast_power(34,1000 ))
